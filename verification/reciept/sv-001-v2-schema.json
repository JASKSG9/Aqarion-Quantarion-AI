{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SV-001-V2 Replay Receipt",
  "type": "object",
  "required": [
    "receipt_version",
    "contract_id",
    "status",
    "evidence_class",
    "domain",
    "verification",
    "binding",
    "runtime",
    "independence",
    "notes"
  ],
  "properties": {
    "receipt_version": { "type": "string" },
    "contract_id": { "const": "SV-001-V2" },
    "status": { "enum": ["PASS", "FAIL"] },
    "evidence_class": { "const": "[V]" },
    "domain": {
      "type": "object",
      "required": ["cases", "zero_r", "nonzero_r"],
      "properties": {
        "cases": { "const": 1176 },
        "zero_r": { "const": 196 },
        "nonzero_r": { "const": 980 }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "cases",
        "failures",
        "max_gram_error",
        "max_trace_error",
        "max_norm_error",
        "status"
      ],
      "properties": {
        "cases": { "const": 1176 },
        "failures": { "type": "integer", "minimum": 0 },
        "max_gram_error": { "type": "number" },
        "max_trace_error": { "type": "number" },
        "max_norm_error": { "type": "number" },
        "status": { "enum": ["PASS", "FAIL"] }
      }
    },
    "binding": {
      "type": "object",
      "required": ["git_commit", "contract_sha256", "manifest_sha256"],
      "properties": {
        "git_commit": { "type": "string" },
        "contract_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["python", "system", "machine"]
    },
    "independence": {
      "type": "object",
      "required": [
        "oracle",
        "verifier",
        "same_algorithm",
        "external_independent_reproduction"
      ],
      "properties": {
        "same_algorithm": { "const": false },
        "external_independent_reproduction": { "const": false }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
